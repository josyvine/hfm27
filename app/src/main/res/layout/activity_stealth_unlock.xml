<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/tv_stealth_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HFM Stealth Gate"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_stealth_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identity Verification Required.\nChoose your verification method:"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="20dp" />

    <!-- Option 1: 4-digit PIN / Biometric -->
    <Button
        android:id="@+id/btn_stealth_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. UNHIDE VIA PIN / FINGERPRINT"
        android:layout_marginBottom="10dp" />

    <!-- Option 2: 3-step Physical Sensor Ritual -->
    <Button
        android:id="@+id/btn_stealth_ritual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. UNHIDE VIA SENSOR RITUAL"
        android:layout_marginBottom="10dp" />

    <!-- Option 3: Map Coordinate Fallback -->
    <Button
        android:id="@+id/btn_stealth_map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. UNHIDE VIA MAP FALLBACK"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btn_stealth_cancel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCEL" />

</LinearLayout>